<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Earnings List</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  ./styles.css
</head>
<body>
  <header>
    <h1>Earnings List</h1>
    <p class="subtitle">Upcoming earnings (auto-updated)</p>
  </header>

  <main>
    <div class="controls">
      <label>Filter by symbol:
        <input id="filter" placeholder="e.g., NVDA, RELIANCE.NS" />
      </label>
      <span id="last-updated"></span>
    </div>

    <table id="tbl">
      <thead>
        <tr>
          <th>Date</th>
          <th>Symbol</th>
          <th>Est. EPS</th>
          <th>Est. Revenue</th>
        </tr>
      </thead>
      <tbody id="rows">
        <tr><td colspan="4">Loading…</td></tr>
      </tbody>
    </table>
  </main>

  <footer>
    <small>Data refreshed by GitHub Actions; served via GitHub Pages.</small>
  </footer>

  ./site.js</script>
</body>
</html>
